RewriteEngine On

# Canonical host: keep the existing platform HTTPS handling.
RewriteCond %{HTTP_HOST} ^www\.onsekizmart\.com$ [NC]
RewriteRule ^(.*)$ https://onsekizmart.com/$1 [R=301,L]

DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .xml .txt .svg
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "\.(css|js|svg)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>
